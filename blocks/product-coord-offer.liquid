{%- doc -%}
  Renders the running automatic discount as a sale price line, in place of the
  theme's plain price: full price struck through, the price the shopper will
  actually pay, and the percentage saved.

  The discount is applied at checkout rather than set as a compare-at price, so
  the theme's own price block has nothing to strike through. This block does the
  arithmetic and hides that plain price while it is showing, which keeps the
  product page honest about what the cart will charge.

  Self-gating on the sale window and on collection membership, so it disappears
  on its own and never promises a reduction the cart will not give. Already
  reduced Special Prices pieces are excluded because they sit outside the
  discount.

  Settings are read from `block.settings` (spacing only).

  @example
  {% content_for 'block', type: 'product-coord-offer', id: 'coord_offer' %}
{%- enddoc -%}

{%- liquid
  # Storewide sale: 10% off everything except already-reduced
  # Special Prices pieces, matching the automatic discount in Shopify admin.
  # Window is 26 Nov 11:10 - 30 Nov 23:59 PKT, stored as UTC epochs.
  # Set offer_enabled to false to pull the line early; update the epochs,
  # percent and copy when the next offer runs.
  assign offer_enabled = true
  assign offer_percent = 10
  assign sale_starts_at = 1795673400
  assign sale_ends_at = 1796065199

  assign now_epoch = 'now' | date: '%s' | times: 1
  assign show_offer = false
  if offer_enabled and now_epoch >= sale_starts_at and now_epoch <= sale_ends_at
    assign show_offer = true
  endif

  for offer_collection in closest.product.collections
    if offer_collection.handle == 'special-prices'
      assign show_offer = false
      break
    endif
  endfor

  assign offer_variant = closest.product.selected_or_first_available_variant
  assign offer_price = offer_variant.price | default: closest.product.price
  assign offer_saving = offer_price | times: offer_percent | divided_by: 100.0 | round
  assign offer_final = offer_price | minus: offer_saving

  # A piece already showing a compare-at markdown is left to the theme's own
  # price block, so the page never stacks two different sale treatments.
  if offer_variant.compare_at_price > offer_variant.price
    assign show_offer = false
  endif
-%}

{%- if show_offer and offer_price > 0 -%}
  <div
    class="bf-price spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <p class="bf-price__row">
      <s class="bf-price__was">{{ offer_price | money }}</s>
      <span class="bf-price__now">{{ offer_final | money }}</span>
      <span class="bf-price__save">Save {{ offer_percent }}%</span>
    </p>
    <p class="bf-price__note">
      {{ offer_percent }}% off applied automatically at checkout
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  /* The sale line stands in for the theme's plain price while it is showing.
     Scoped to the details column that holds this block, so prices in other
     sections (related products, cards) are untouched. */
  .product-details:has(.bf-price) product-price {
    display: none;
  }

  .bf-price {
    --bf-ink: #2b2620;
    --bf-muted: #8a8178;
    --bf-sale: #b5544d;
    margin: 0;
    font-family: var(--font-body--family);
  }

  .bf-price__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.75rem;
    margin: 0;
    line-height: 1.3;
  }

  .bf-price__was {
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--bf-muted);
    text-decoration-thickness: 1px;
  }

  .bf-price__now {
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--bf-ink);
  }

  .bf-price__save {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--bf-sale);
    white-space: nowrap;
  }

  .bf-price__note {
    margin: 0.4rem 0 0;
    font-size: 0.74rem;
    letter-spacing: 0.03em;
    line-height: 1.5;
    color: var(--bf-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sale price line",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the running automatic discount as a sale price: full price struck through, the price paid at checkout, and the percentage saved. Replaces the plain price while it is showing. Already-reduced Special Prices pieces are excluded. Dates, percent, copy and the on/off switch live in blocks/product-coord-offer.liquid."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Sale price line",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
