{%- liquid
  # Independence Day sale banner for the Pret and Block Print collection
  # pages. Same self-gating window as blocks/product-sale-note.liquid
  # (Aug 12 00:00 - Aug 16 23:59 PKT, stored as UTC epochs), so it appears
  # and disappears with the sale and needs no cleanup.
  assign sale_starts_at = 1786474800
  assign sale_ends_at = 1786906799
  assign now_epoch = 'now' | date: '%s' | times: 1

  assign in_sale_window = false
  if now_epoch >= sale_starts_at and now_epoch <= sale_ends_at
    assign in_sale_window = true
  endif

  # Pret contains Special Prices pieces that sit outside the discount, so its
  # line carries the exclusion qualifier. Block Print is discounted in full.
  assign sale_note_text = ''
  if closest.collection.handle == 'block-print'
    assign sale_note_text = '10% off this collection &mdash; applied automatically at checkout &middot; ends Sunday, Aug 16'
  elsif closest.collection.handle == 'pret'
    assign sale_note_text = '10% off &mdash; applied automatically at checkout &middot; ends Sunday, Aug 16 <span class="collection-sale-note__qualifier">(already-reduced pieces excluded)</span>'
  endif
-%}

{%- if in_sale_window and sale_note_text != blank -%}
  <p
    class="collection-sale-note spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <span class="collection-sale-note__label">Independence Day Sale</span>
    <span class="collection-sale-note__text">{{ sale_note_text }}</span>
  </p>
{%- endif -%}

{% stylesheet %}
  .collection-sale-note {
    margin: 0;
    width: 100%;
    text-align: center;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    line-height: 1.6;
    color: #2b5e43;
  }

  .collection-sale-note__label {
    display: inline-block;
    margin-inline-end: 0.5em;
    padding: 0.25em 0.6em;
    background: #2b5e43;
    color: #f7f3ec;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.4;
    vertical-align: middle;
  }

  .collection-sale-note__qualifier {
    opacity: 0.75;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection sale note",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the Independence Day sale line on the Pret and Block Print collection pages during the sale window. Dates and copy live in blocks/collection-sale-note.liquid."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection sale note",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
