{%- liquid
  # Blessed Friday / 10K sale banner across collection pages. Self-gating on
  # the sale window (26 Nov 11:10 - 30 Nov 23:59 PKT, stored as UTC epochs),
  # so it appears and disappears with the sale and needs no cleanup.
  assign sale_starts_at = 1795673400
  assign sale_ends_at = 1796065199
  assign now_epoch = 'now' | date: '%s' | times: 1

  assign in_sale_window = false
  if now_epoch >= sale_starts_at and now_epoch <= sale_ends_at
    assign in_sale_window = true
  endif

  # The discount covers every active piece except the already-reduced Special
  # Prices ones, so that collection carries no banner at all. Collections that
  # merely contain one of those pieces still get the banner, with a qualifier
  # so the line is never a promise the cart will break.
  assign sale_collection = closest.collection.handle
  assign mixed_handles = 'pret,formals,festive-wear,summer' | split: ','

  assign sale_note_text = ''
  if sale_collection != 'special-prices'
    assign sale_note_text = '10% off everything &mdash; applied automatically at checkout &middot; ends Monday, Nov 30'
    if mixed_handles contains sale_collection
      assign sale_note_text = sale_note_text | append: ' <span class="collection-sale-note__qualifier">(already-reduced pieces excluded)</span>'
    endif
  endif
-%}

{%- if in_sale_window and sale_note_text != blank -%}
  <p
    class="collection-sale-note spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <span class="collection-sale-note__label">Blessed Friday</span>
    <span class="collection-sale-note__text">{{ sale_note_text }}</span>
  </p>
{%- endif -%}

{% stylesheet %}
  .collection-sale-note {
    margin: 0;
    width: 100%;
    text-align: center;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    line-height: 1.6;
    color: #5f574d;
  }

  .collection-sale-note__label {
    display: inline-block;
    margin-inline-end: 0.5em;
    padding: 0.25em 0.6em;
    background: #2b2620;
    color: #f7f3ec;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.4;
    vertical-align: middle;
  }

  .collection-sale-note__qualifier {
    opacity: 0.75;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection sale note",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the running sale line at the top of collection pages during the sale window. Already-reduced Special Prices pieces are excluded, and mixed collections carry a qualifier. Dates, copy and the sale window live in blocks/collection-sale-note.liquid."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection sale note",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
