{%- liquid
  # Independence Day sale note for Pret and Block Print pieces.
  # The 10% automatic discount only surfaces at checkout, so this line tells
  # shoppers on the product page. Self-gating: shows only inside the sale
  # window (Aug 12 00:00 - Aug 16 23:59 PKT, stored as UTC epochs) so no
  # theme change is needed when the sale ends.
  assign sale_starts_at = 1786474800
  assign sale_ends_at = 1786906799
  assign now_epoch = 'now' | date: '%s' | times: 1

  assign in_sale_window = false
  if now_epoch >= sale_starts_at and now_epoch <= sale_ends_at
    assign in_sale_window = true
  endif

  assign in_sale_collection = false
  assign in_excluded_collection = false
  for sale_note_collection in closest.product.collections
    if sale_note_collection.handle == 'pret' or sale_note_collection.handle == 'block-print'
      assign in_sale_collection = true
    endif
    # Special Prices pieces are already reduced and sit outside the discount,
    # so they must not advertise it.
    if sale_note_collection.handle == 'special-prices'
      assign in_excluded_collection = true
    endif
  endfor
  if in_excluded_collection
    assign in_sale_collection = false
  endif
-%}

{%- if in_sale_window and in_sale_collection -%}
  <p
    class="product-sale-note spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <span class="product-sale-note__label">Independence Day Sale</span>
    10% off applied automatically at checkout &middot; ends Aug 16
  </p>
{%- endif -%}

{% stylesheet %}
  .product-sale-note {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    line-height: 1.5;
    color: #2b5e43;
  }

  .product-sale-note__label {
    display: inline-block;
    margin-inline-end: 0.5em;
    padding: 0.25em 0.6em;
    background: #2b5e43;
    color: #f7f3ec;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.4;
    vertical-align: middle;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Independence sale note",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the Independence Day sale line on Pret and Block Print products during the sale window. Dates and copy live in blocks/product-sale-note.liquid."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Independence sale note",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
