{
  "store": "x1hna4-kw.myshopify.com",
  "api_version": "2026-10",
  "online_store_publication_title_contains": "Online Store",

  "hard_rules": {
    "_note": "Enforced by apply.mjs. The script never changes a collection handle or a product title, and stops if a planned change would delete a pre-existing collection or touch anything listed under do_not_touch.",
    "collections_created_during_task_on_or_after": "2026-11-18T10:00:00Z"
  },

  "do_not_touch": {
    "_note": "Revised list 2026-11-18: Summer Collection stays exactly as it is (title, handle, unpublished, products incl. Olive Whisper) and so does its redirect.",
    "collections": ["summer-collection"],
    "redirect_paths": ["/collections/summer-collection"]
  },

  "matching": {
    "rule": "Config titles match Shopify product titles case-insensitively after trimming. A title that matches zero products, or more than one without a pin below, stops the run.",
    "title_aliases": {
      "Black Leopard": "Black Leopard - Shirt"
    },
    "handle_pins": {
      "_note": "These titles exist twice in Shopify: one ACTIVE product plus an older DRAFT duplicate. Each pin selects the product that was ACTIVE on 2026-11-18.",
      "Green Forest": "green-forest",
      "Cape Set": "cape-set",
      "Navy Scroll": "navy-scroll",
      "Zebra Set": "zebra-set",
      "Cobalt Charm": "cobalt-charm",
      "Blue Forest": "blue-forest",
      "Emerald Wrap": "emerald-wrap-1",
      "Rust Scroll": "rust-scroll",
      "Marrakech": "marrakech-1",
      "Blue Roses": "blue-roses",
      "Diamond Lattice": "diamond-lattice",
      "Lace Jacket": "lace-jacket",
      "Berry Noir": "berry-noir-1",
      "Midnight Vintage": "midnight-vintage-1"
    }
  },

  "hide_products": {
    "_note": "Status set to DRAFT only. Memberships are kept, except in collections below whose product list is set exactly.",
    "status": "DRAFT",
    "titles": [
      "Vintage Coral", "Soft Petals", "Saffron Check", "Black Leopard", "Pistachio Rose",
      "Sea Mist", "Serenade Beige", "Serenade Blue", "Elara", "Mint Scroll",
      "Diamond Lattice", "Flora Inlay", "Wisteria", "Muted Iris", "Smocked Serenity",
      "Berry Noir", "Aura", "Lace Jacket", "Motiya", "Chantelle Lace Gold",
      "Slate Whisper", "Peach Floret"
    ],
    "expected_active_after": 46
  },

  "collections": [
    {
      "_note": "Existing collection, renamed from Pret. Handle unchanged.",
      "group": "by_collection",
      "title": "Everyday Wear",
      "handle": "pret",
      "products": [
        "Quiet Sage", "Quiet Ivory", "Stone Willow", "Misty Blue", "Desert Blush", "Ash Blue Wrap",
        "Blue Haze", "Buttercream Wrap", "Soft Scallop", "Pearly Green", "Ivory Lattice", "Sand Stone"
      ]
    },
    {
      "_note": "Existing collection, renamed from Co-ord Sets. Handle unchanged.",
      "group": "by_collection",
      "title": "Matching Sets",
      "handle": "co-ord-sets",
      "products": [
        "Pressed Fern", "Olive Ease Set", "Pink Ease Set", "Cape Set", "Green Forest", "Blue Forest",
        "Rust Scroll", "Zebra Set", "Navy Scroll", "Riviera", "Marrakech", "Emerald Wrap",
        "Vintage Blossom", "Cabana", "Saffron Ruffles"
      ]
    },
    {
      "_note": "Existing collection, renamed from Formals. Handle unchanged.",
      "group": "by_collection",
      "title": "Occasion Wear",
      "handle": "formals",
      "products": ["Midnight Vintage", "Coral Dust", "Midnight Lace", "Teal Brocade", "Gold Heritage"]
    },
    {
      "group": "by_collection",
      "title": "Festive Wear",
      "handle": "festive-wear",
      "products": ["Ivory Shisha", "Ash Blossom", "Lali", "Lumina", "Fuchsia Angrakha"]
    },
    {
      "group": "by_collection",
      "title": "Dinner Wear",
      "handle": "dinner-wear",
      "products": [
        "Black Boom", "Midnight Blossom", "Pressed Lilac", "Pine Pink", "Rose Blush",
        "Blue Roses", "Sea Glass", "Cobalt Charm", "Taupe"
      ]
    },
    {
      "group": "by_season",
      "title": "Winter",
      "handle": "winter",
      "products": [
        "Riviera", "Blue Roses", "Marrakech", "Rust Scroll", "Emerald Wrap", "Cobalt Charm",
        "Zebra Set", "Navy Scroll", "Saffron Ruffles", "Cabana", "Vintage Blossom", "Taupe",
        "Blue Forest", "Green Forest", "Cape Set", "Pressed Fern"
      ]
    },
    {
      "_note": "The collection created 2026-11-18 (gid://shopify/Collection/578491515191), not Summer Collection.",
      "group": "by_season",
      "title": "Summer",
      "handle": "summer",
      "products": [
        "Quiet Sage", "Quiet Ivory", "Stone Willow", "Misty Blue", "Desert Blush", "Ash Blue Wrap",
        "Blue Haze", "Buttercream Wrap", "Soft Scallop", "Pearly Green", "Ivory Lattice", "Lali"
      ]
    },
    {
      "group": "by_season",
      "title": "All Year Round",
      "handle": "all-year-round",
      "products": [
        "Sea Glass", "Pine Pink", "Black Boom", "Pressed Lilac", "Sand Stone",
        "Midnight Blossom", "Lumina", "Midnight Lace"
      ]
    }
  ],

  "assertions": {
    "_note": "by_collection lists must cover the active products after hiding exactly once each. Season lists plus unassigned_season must do the same.",
    "by_collection_covers_active_exactly_once": true,
    "by_season_plus_unassigned_covers_active_exactly_once": true
  },

  "unassigned_season": [
    "Midnight Vintage", "Teal Brocade", "Coral Dust", "Pink Ease Set", "Olive Ease Set",
    "Fuchsia Angrakha", "Rose Blush", "Ivory Shisha", "Ash Blossom", "Gold Heritage"
  ],

  "cleanup": {
    "_note": "Leftovers from the first attempt on 2026-11-18. A collection is deleted only if its id matches, it was created on or after hard_rules.collections_created_during_task_on_or_after, and it has no products.",
    "delete_menus_by_handle": ["main-menu-new"],
    "delete_collections": [
      { "handle": "everyday-wear", "id": "gid://shopify/Collection/578491318583" },
      { "handle": "matching-sets", "id": "gid://shopify/Collection/578491351351" },
      { "handle": "occasion-wear", "id": "gid://shopify/Collection/578491384119" }
    ]
  },

  "redirects": {
    "_note": "Must exist after the run. Missing ones are created after the cleanup deletes, so the path is free when the redirect is added. An existing redirect with a different target stops the run.",
    "ensure": [
      { "path": "/collections/occasion-wear", "target": "/collections/formals" }
    ]
  },

  "menu": {
    "handle": "main-menu",
    "title": "Main menu",
    "items": [
      { "title": "NEW IN", "collection": "new-in" },
      {
        "title": "SHOP",
        "type": "CATALOG",
        "items": [
          {
            "title": "By Collection",
            "type": "CATALOG",
            "items": [
              { "title": "Everyday Wear", "collection": "pret" },
              { "title": "Matching Sets", "collection": "co-ord-sets" },
              { "title": "Occasion Wear", "collection": "formals" },
              { "title": "Festive Wear", "collection": "festive-wear" },
              { "title": "Dinner Wear", "collection": "dinner-wear" }
            ]
          },
          {
            "title": "By Season",
            "type": "CATALOG",
            "items": [
              { "title": "Winter", "collection": "winter" },
              { "title": "Summer", "collection": "summer" },
              { "title": "All Year Round", "collection": "all-year-round" }
            ]
          },
          { "title": "Special Prices", "collection": "special-prices" }
        ]
      }
    ]
  }
}
