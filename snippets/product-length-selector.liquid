{%- doc -%}
  Renders Shirt Length and Bottom Length radio button selectors as line item properties.
  These bypass the 3-option variant limit by submitting as properties[] instead of variant options.

  @param {string} form_id - The product form ID to associate inputs with
  @param {object} product - The current product object
{%- enddoc -%}

{%- assign product_title_normalized = product.title | downcase | strip -%}

{%- assign hide_length_selectors = false -%}
{%- assign hide_length_selector_handles = 'chantelle-lace-gold,guilded-gold-jacket' | split: ',' -%}
{%- if hide_length_selector_handles contains product.handle -%}
  {%- assign hide_length_selectors = true -%}
{%- else -%}
  {%- for hide_length_selector_collection in product.collections -%}
    {%- if hide_length_selector_collection.handle == 'wedding' -%}
      {%- assign hide_length_selectors = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if hide_length_selectors -%}
  <div class="made-to-measure">
    <p class="made-to-measure__title">Made to Measure</p>
    <p class="made-to-measure__body">
      To honor the intricate heritage craftsmanship and ensure a flawless drape, this ensemble is
      exclusively available as a custom, made-to-order piece. Upon placing your order, our design team
      will contact you directly to guide you through our bespoke measurement process to ensure precise
      tailoring.
    </p>
  </div>
{%- endif -%}

{%- unless hide_length_selectors -%}

{%- if product.handle == 'ash-blue-wrap' -%}
  {%- assign shirt_lengths = '26,27,28' | split: ',' -%}
  {%- assign bottom_lengths = '39,40,42' | split: ',' -%}
  {%- assign default_shirt_length = '26' -%}
  {%- assign default_bottom_length = '39' -%}
{%- elsif product.handle == 'midnight-blossom' -%}
  {%- assign shirt_lengths = '27,28,29' | split: ',' -%}
  {%- assign bottom_lengths = '40,42,44' | split: ',' -%}
  {%- assign pants_styles = 'Wide Legged Pleated Pants,Fluid Drape Trousers' | split: ',' -%}
  {%- assign default_shirt_length = '28' -%}
  {%- assign default_bottom_length = '42' -%}
  {%- assign default_pants_style = 'Wide Legged Pleated Pants' -%}
{%- elsif product.handle == 'pistachio-rose' -%}
  {%- assign shirt_lengths = '48,50,52' | split: ',' -%}
  {%- assign bottom_lengths = '40,42,44' | split: ',' -%}
  {%- assign default_shirt_length = '50' -%}
  {%- assign default_bottom_length = '42' -%}
  {%- assign lead_time = '6-8 weeks' -%}
{%- elsif product.handle == 'sea-mist-panel' -%}
  {%- assign shirt_lengths = '28,30,32 (Standard),34' | split: ',' -%}
  {%- assign bottom_lengths = '38,40,42 (Standard),44' | split: ',' -%}
  {%- assign default_shirt_length = '32 (Standard)' -%}
  {%- assign default_bottom_length = '42 (Standard)' -%}
  {%- assign lead_time = '6-8 weeks' -%}
{%- elsif product.handle == 'quiet-ivory' or product.handle == 'stone-willow' or product.handle == 'misty-blue' or product.handle == 'desert-blush' -%}
  {%- assign shirt_lengths = '28' | split: ',' -%}
  {%- assign bottom_lengths = '38,40,42 (Standard),44' | split: ',' -%}
  {%- assign default_shirt_length = '28' -%}
  {%- assign default_bottom_length = '42 (Standard)' -%}
{%- elsif product_title_normalized == 'quiet sage' -%}
  {%- assign shirt_lengths = '28' | split: ',' -%}
  {%- assign bottom_lengths = '38,40,42 (Standard),44' | split: ',' -%}
  {%- assign default_shirt_length = '28' -%}
  {%- assign default_bottom_length = '42 (Standard)' -%}
{%- elsif product.handle == 'coral-dust' or product.handle == 'black-leopard' or product.handle == 'pearly-green' or product.handle == 'ash-blossom' or product.handle == 'ivory-shisha' or product.handle == 'fuschia-floret' or product.handle == 'pink-floret-1' -%}
  {%- comment -%} Special Prices collection: same lengths as default, minus 34 on the shirt. {%- endcomment -%}
  {%- assign shirt_lengths = '28,30,32 (Standard)' | split: ',' -%}
  {%- assign bottom_lengths = '38,40,42 (Standard),44' | split: ',' -%}
  {%- assign default_shirt_length = '32 (Standard)' -%}
  {%- assign default_bottom_length = '42 (Standard)' -%}
{%- else -%}
  {%- assign shirt_lengths = '28,30,32 (Standard),34' | split: ',' -%}
  {%- assign bottom_lengths = '38,40,42 (Standard),44' | split: ',' -%}
  {%- assign default_shirt_length = '32 (Standard)' -%}
  {%- assign default_bottom_length = '42 (Standard)' -%}
{%- endif -%}

{%- comment -%}
  Shirt-only pieces, which have no bottom to measure. Clearing the list here
  rather than in the chain above lets them keep their shirt lengths.
{%- endcomment -%}
{%- assign shirt_only_handles = 'black-leopard' | split: ',' -%}
{%- if shirt_only_handles contains product.handle -%}
  {%- assign bottom_lengths = '' | split: ',' -%}
{%- endif -%}

{%- comment -%}
  Pieces offered in more than one pants cut. Kept separate from the length
  chain above so a product can pick up a pants style without restating its
  lengths.
{%- endcomment -%}
{%- if product.handle == 'serenade-blue' -%}
  {%- assign pants_styles = 'Cropped Pants,Pleated Pants' | split: ',' -%}
  {%- assign default_pants_style = 'Cropped Pants' -%}
{%- endif -%}

<details class="length-collapse">
  <summary class="length-collapse__summary">
    <span class="length-collapse__title">Free made-to-measure lengths</span>
    <span class="length-collapse__hint">Standard fit preselected &middot; adjust at no extra cost</span>
    <svg class="length-collapse__caret" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true" focusable="false"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </summary>

<div class="product-length-selectors">
  <fieldset class="variant-option variant-option--buttons">
    <legend>Shirt Length</legend>
    {%- for length in shirt_lengths -%}
      <label class="length-selector__label">
        <input
          type="radio"
          name="properties[Shirt Length]"
          value="{{ length }}"
          form="{{ form_id }}"
          {% if length == default_shirt_length %}checked{% endif %}
        >
        <span class="length-selector__text">{{ length }}</span>
      </label>
    {%- endfor -%}
  </fieldset>

  {%- if bottom_lengths.size > 0 -%}
    <fieldset class="variant-option variant-option--buttons">
      <legend>Bottom Length</legend>
      {%- for length in bottom_lengths -%}
        <label class="length-selector__label">
          <input
            type="radio"
            name="properties[Bottom Length]"
            value="{{ length }}"
            form="{{ form_id }}"
            {% if length == default_bottom_length %}checked{% endif %}
          >
          <span class="length-selector__text">{{ length }}</span>
        </label>
      {%- endfor -%}
    </fieldset>
  {%- endif -%}

  {%- if pants_styles.size > 0 -%}
    <fieldset class="variant-option variant-option--buttons" data-pants-style>
      <legend>Pants Style</legend>
      {%- for style in pants_styles -%}
        {%- liquid
          # Link each cut to the photo that shows it, matched on the image alt
          # text or filename (e.g. "...CroppedPants.png" for "Cropped Pants").
          assign style_key = style | split: ' ' | first | downcase
          assign style_media_id = ''
          for style_media in product.media
            assign style_media_alt = style_media.alt | default: '' | downcase
            assign style_media_src = style_media.preview_image | image_url: width: 200 | downcase
            if style_media_alt contains style_key or style_media_src contains style_key
              assign style_media_id = style_media.id
              break
            endif
          endfor
        -%}
        <label class="length-selector__label">
          <input
            type="radio"
            name="properties[Pants Style]"
            value="{{ style }}"
            form="{{ form_id }}"
            {% if style_media_id != blank %}
              data-media-id="{{ style_media_id }}"
            {% endif %}
            {% if style == default_pants_style %}checked{% endif %}
          >
          <span class="length-selector__text">{{ style }}</span>
        </label>
      {%- endfor -%}
    </fieldset>
  {%- endif -%}

</div>
</details>

{%- comment -%}
  Lead time now renders once, from product-stylist-cta.liquid, so the
  per-handle lead_time assigns above only feed that single source.
{%- endcomment -%}

{%- endunless -%}

{%- if pants_styles.size > 0 -%}
  <script>
    (function () {
      var fieldset = document.querySelector('[data-pants-style]');
      var gallery = document.querySelector('.media-gallery__grid');
      if (!fieldset || !gallery) return;

      var inputs = fieldset.querySelectorAll('input[data-media-id]');
      if (!inputs.length) return;

      function focusMedia(mediaId) {
        var marked = gallery.querySelectorAll('[data-media-id]');
        if (!marked.length) return;

        gallery.classList.add('media-gallery__grid--style-linked');

        marked.forEach(function (node) {
          var item = node.closest('li') || node;
          var isMatch = node.getAttribute('data-media-id') === mediaId;
          item.classList.toggle('media-item--style-active', isMatch);
          item.classList.toggle('media-item--style-muted', !isMatch);

          // On mobile the gallery scrolls horizontally, so bring the
          // matching photo into view. Skipped on the desktop grid, where
          // both photos are already visible and scrolling would jump the page.
          if (isMatch && gallery.scrollWidth > gallery.clientWidth + 1) {
            item.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        });
      }

      inputs.forEach(function (input) {
        input.addEventListener('change', function () {
          if (input.checked) focusMedia(input.getAttribute('data-media-id'));
        });
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  /* Selecting a pants cut fades the gallery toward the photo showing it.
     Only applies once the shopper picks a cut, so the page loads clean. */
  .media-gallery__grid--style-linked li {
    transition: opacity 0.45s ease, filter 0.45s ease;
  }

  .media-gallery__grid--style-linked li.media-item--style-muted {
    opacity: 0.4;
    filter: saturate(0.9);
  }

  .media-gallery__grid--style-linked li.media-item--style-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .media-gallery__grid--style-linked li {
      transition: none;
    }
  }

  .made-to-measure {
    width: 100%;
    padding-block: var(--padding-lg);
    padding-inline: var(--padding-lg);
    border: var(--options-border-width) solid var(--color-variant-border);
    border-radius: var(--options-border-radius);
    background-color: var(--color-variant-background);
  }

  .made-to-measure__title {
    margin: 0 0 var(--padding-xs);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .made-to-measure__body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    opacity: 0.8;
  }

  .length-collapse {
    width: 100%;
    border: var(--options-border-width) solid var(--color-variant-border);
    border-radius: var(--options-border-radius);
    background-color: var(--color-variant-background);
  }

  .length-collapse__summary {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    padding-block: var(--padding-sm);
    padding-inline: var(--padding-lg);
    min-height: 3.25em;
    align-items: center;
    cursor: pointer;
    list-style: none;
  }

  .length-collapse__summary::-webkit-details-marker {
    display: none;
  }

  .length-collapse__title {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.9;
    white-space: nowrap;
  }

  .length-collapse__hint {
    flex: 1 1 auto;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    opacity: 0.6;
  }

  .length-collapse__caret {
    flex: 0 0 auto;
    opacity: 0.6;
    transition: transform 0.25s ease;
  }

  .length-collapse[open] .length-collapse__caret {
    transform: rotate(180deg);
  }

  .length-collapse[open] .length-collapse__hint {
    visibility: hidden;
  }

  .length-collapse:has(summary:focus-visible) {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: var(--focus-outline-offset);
  }

  .product-length-selectors {
    width: 100%;
    padding-block: var(--padding-xs) var(--padding-lg);
    padding-inline: var(--padding-lg);
  }

  .product-length-selectors .variant-option + .variant-option {
    margin-top: var(--padding-lg);
  }

  .length-selector__lead-time {
    margin-top: var(--padding-lg);
    font-size: 0.875rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    opacity: 0.75;
  }

  .length-selector__lead-time-label {
    display: inline-block;
    margin-inline-end: 0.5em;
    padding-block: 0.15em;
    padding-inline: 0.6em;
    border: var(--options-border-width) solid var(--color-variant-border);
    border-radius: var(--options-border-radius);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .length-selector__label {
    cursor: pointer;
    display: flex;
    flex: 0 0 3.25em;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-block: var(--padding-sm);
    padding-inline: var(--padding-lg);
    border: var(--options-border-width) solid var(--color-variant-border);
    border-radius: var(--options-border-radius);
    overflow: clip;
    min-height: 3.25em;
    min-width: fit-content;
    white-space: nowrap;
    background-color: var(--color-variant-background);
    color: var(--color-variant-text);
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  @media screen and (min-width: 750px) {
    .length-selector__label {
      padding: var(--padding-xs) var(--variant-option-padding-inline);
    }
  }

  .length-selector__label:hover {
    background-color: var(--color-variant-hover-background);
    border-color: var(--color-variant-hover-border);
    color: var(--color-variant-hover-text);
  }

  .length-selector__label:has(:checked) {
    background-color: var(--color-selected-variant-background);
    border-color: var(--color-selected-variant-border);
    color: var(--color-selected-variant-text);
  }

  .length-selector__label:has(:checked):hover {
    background-color: var(--color-selected-variant-hover-background);
    border-color: var(--color-selected-variant-hover-border);
    color: var(--color-selected-variant-hover-text);
  }

  .length-selector__label:has(:focus-visible) {
    border-color: var(--color-foreground);
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: var(--focus-outline-offset);
  }

  .length-selector__label input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 0;
    background: transparent;
    appearance: auto;
    display: block;
    cursor: pointer;
  }

  .length-selector__text {
    pointer-events: none;
    text-align: start;
    text-wrap: auto;
    z-index: 1;
  }
{% endstylesheet %}
