{%- doc -%}
  Renders Shirt Length and Bottom Length radio button selectors as line item properties.
  These bypass the 3-option variant limit by submitting as properties[] instead of variant options.

  @param {string} form_id - The product form ID to associate inputs with
  @param {object} product - The current product object
{%- enddoc -%}

{%- assign product_title_normalized = product.title | downcase | strip -%}

{%- assign hide_length_selectors = false -%}
{%- assign hide_length_selector_handles = 'chantelle-lace-gold,guilded-gold-jacket' | split: ',' -%}
{%- if hide_length_selector_handles contains product.handle -%}
  {%- assign hide_length_selectors = true -%}
{%- else -%}
  {%- for hide_length_selector_collection in product.collections -%}
    {%- if hide_length_selector_collection.handle == 'wedding' -%}
      {%- assign hide_length_selectors = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if hide_length_selectors -%}
  <div class="made-to-measure">
    <p class="made-to-measure__title">Made to Measure</p>
    <p class="made-to-measure__body">
      To honor the intricate heritage craftsmanship and ensure a flawless drape, this ensemble is
      exclusively available as a custom, made-to-order piece. Upon placing your order, our design team
      will contact you directly to guide you through our bespoke measurement process to ensure precise
      tailoring.
    </p>
  </div>
{%- endif -%}

{%- unless hide_length_selectors -%}

{%- if product.handle == 'ash-blue-wrap' -%}
  {%- assign shirt_lengths = '26,27,28' | split: ',' -%}
  {%- assign bottom_lengths = '39,40,42' | split: ',' -%}
  {%- assign default_shirt_length = '26' -%}
  {%- assign default_bottom_length = '39' -%}
{%- elsif product.handle == 'midnight-blossom' -%}
  {%- assign shirt_lengths = '27,28,29' | split: ',' -%}
  {%- assign bottom_lengths = '40,42,44' | split: ',' -%}
  {%- assign pants_styles = 'Wide Legged Pleated Pants,Fluid Drape Trousers' | split: ',' -%}
  {%- assign default_shirt_length = '28' -%}
  {%- assign default_bottom_length = '42' -%}
  {%- assign default_pants_style = 'Wide Legged Pleated Pants' -%}
{%- elsif product.handle == 'pistachio-rose' -%}
  {%- assign shirt_lengths = '48,50,52' | split: ',' -%}
  {%- assign bottom_lengths = '40,42,44' | split: ',' -%}
  {%- assign default_shirt_length = '50' -%}
  {%- assign default_bottom_length = '42' -%}
  {%- assign lead_time = '6-8 weeks' -%}
{%- elsif product.handle == 'sea-mist-panel' -%}
  {%- assign shirt_lengths = '28,30,32 (Standard),34' | split: ',' -%}
  {%- assign bottom_lengths = '38,40,42 (Standard),44' | split: ',' -%}
  {%- assign default_shirt_length = '32 (Standard)' -%}
  {%- assign default_bottom_length = '42 (Standard)' -%}
  {%- assign lead_time = '6-8 weeks' -%}
{%- elsif product.handle == 'quiet-ivory' or product.handle == 'stone-willow' or product.handle == 'misty-blue' or product.handle == 'desert-blush' -%}
  {%- assign shirt_lengths = '28' | split: ',' -%}
  {%- assign bottom_lengths = '38,40,42 (Standard),44' | split: ',' -%}
  {%- assign default_shirt_length = '28' -%}
  {%- assign default_bottom_length = '42 (Standard)' -%}
{%- elsif product_title_normalized == 'quiet sage' -%}
  {%- assign shirt_lengths = '28' | split: ',' -%}
  {%- assign bottom_lengths = '38,40,42 (Standard),44' | split: ',' -%}
  {%- assign default_shirt_length = '28' -%}
  {%- assign default_bottom_length = '42 (Standard)' -%}
{%- else -%}
  {%- assign shirt_lengths = '28,30,32 (Standard),34' | split: ',' -%}
  {%- assign bottom_lengths = '38,40,42 (Standard),44' | split: ',' -%}
  {%- assign default_shirt_length = '32 (Standard)' -%}
  {%- assign default_bottom_length = '42 (Standard)' -%}
{%- endif -%}

<div class="product-length-selectors">
  <fieldset class="variant-option variant-option--buttons">
    <legend>Shirt Length</legend>
    {%- for length in shirt_lengths -%}
      <label class="length-selector__label">
        <input
          type="radio"
          name="properties[Shirt Length]"
          value="{{ length }}"
          form="{{ form_id }}"
          {% if length == default_shirt_length %}checked{% endif %}
        >
        <span class="length-selector__text">{{ length }}</span>
      </label>
    {%- endfor -%}
  </fieldset>

  {%- if bottom_lengths.size > 0 -%}
    <fieldset class="variant-option variant-option--buttons">
      <legend>Bottom Length</legend>
      {%- for length in bottom_lengths -%}
        <label class="length-selector__label">
          <input
            type="radio"
            name="properties[Bottom Length]"
            value="{{ length }}"
            form="{{ form_id }}"
            {% if length == default_bottom_length %}checked{% endif %}
          >
          <span class="length-selector__text">{{ length }}</span>
        </label>
      {%- endfor -%}
    </fieldset>
  {%- endif -%}

  {%- if pants_styles.size > 0 -%}
    <fieldset class="variant-option variant-option--buttons">
      <legend>Pants Style</legend>
      {%- for style in pants_styles -%}
        <label class="length-selector__label">
          <input
            type="radio"
            name="properties[Pants Style]"
            value="{{ style }}"
            form="{{ form_id }}"
            {% if style == default_pants_style %}checked{% endif %}
          >
          <span class="length-selector__text">{{ style }}</span>
        </label>
      {%- endfor -%}
    </fieldset>
  {%- endif -%}

  {%- if lead_time != blank -%}
    <p class="length-selector__lead-time">
      <span class="length-selector__lead-time-label">Made to order</span>
      Ships in {{ lead_time }}
    </p>
  {%- endif -%}
</div>

{%- endunless -%}

{% stylesheet %}
  .made-to-measure {
    width: 100%;
    padding-block: var(--padding-lg);
    padding-inline: var(--padding-lg);
    border: var(--options-border-width) solid var(--color-variant-border);
    border-radius: var(--options-border-radius);
    background-color: var(--color-variant-background);
  }

  .made-to-measure__title {
    margin: 0 0 var(--padding-xs);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .made-to-measure__body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    opacity: 0.8;
  }

  .product-length-selectors {
    width: 100%;
  }

  .product-length-selectors .variant-option + .variant-option {
    margin-top: var(--padding-lg);
  }

  .length-selector__lead-time {
    margin-top: var(--padding-lg);
    font-size: 0.875rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    opacity: 0.75;
  }

  .length-selector__lead-time-label {
    display: inline-block;
    margin-inline-end: 0.5em;
    padding-block: 0.15em;
    padding-inline: 0.6em;
    border: var(--options-border-width) solid var(--color-variant-border);
    border-radius: var(--options-border-radius);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .length-selector__label {
    cursor: pointer;
    display: flex;
    flex: 0 0 3.25em;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-block: var(--padding-sm);
    padding-inline: var(--padding-lg);
    border: var(--options-border-width) solid var(--color-variant-border);
    border-radius: var(--options-border-radius);
    overflow: clip;
    min-height: 3.25em;
    min-width: fit-content;
    white-space: nowrap;
    background-color: var(--color-variant-background);
    color: var(--color-variant-text);
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  @media screen and (min-width: 750px) {
    .length-selector__label {
      padding: var(--padding-xs) var(--variant-option-padding-inline);
    }
  }

  .length-selector__label:hover {
    background-color: var(--color-variant-hover-background);
    border-color: var(--color-variant-hover-border);
    color: var(--color-variant-hover-text);
  }

  .length-selector__label:has(:checked) {
    background-color: var(--color-selected-variant-background);
    border-color: var(--color-selected-variant-border);
    color: var(--color-selected-variant-text);
  }

  .length-selector__label:has(:checked):hover {
    background-color: var(--color-selected-variant-hover-background);
    border-color: var(--color-selected-variant-hover-border);
    color: var(--color-selected-variant-hover-text);
  }

  .length-selector__label:has(:focus-visible) {
    border-color: var(--color-foreground);
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: var(--focus-outline-offset);
  }

  .length-selector__label input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 0;
    background: transparent;
    appearance: auto;
    display: block;
    cursor: pointer;
  }

  .length-selector__text {
    pointer-events: none;
    text-align: start;
    text-wrap: auto;
    z-index: 1;
  }
{% endstylesheet %}
