{%- doc -%}
  Renders a "Speak to a Stylist" WhatsApp CTA on high-touch collections
  (wedding, formals). Pre-fills a WhatsApp message with the product title and
  URL so the team has context. Extend collection coverage via the handle list
  in stylist_cta_collections below.

  @param {object} product - The current product object
{%- enddoc -%}

{%- liquid
  assign stylist_cta_number = '923717459654'
  assign stylist_cta_collections = 'wedding,formals' | split: ','

  assign show_stylist_cta = false
  for stylist_cta_collection in product.collections
    if stylist_cta_collections contains stylist_cta_collection.handle
      assign show_stylist_cta = true
      break
    endif
  endfor
-%}

{%- if show_stylist_cta -%}
  {%- capture stylist_cta_message -%}Hello Jannat & Sadaf, I would love some styling help with {{ product.title }} ({{ shop.url }}{{ product.url }}). Could you please assist me?{%- endcapture -%}

  <a
    class="stylist-cta"
    href="https://wa.me/{{ stylist_cta_number }}?text={{ stylist_cta_message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="Request styling help on WhatsApp"
  >
    <span class="stylist-cta__button">
      <svg
        class="stylist-cta__icon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24Zm4.52 10.32c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42-.14 0-.31-.02-.47-.02-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"
        />
      </svg>
      <span class="stylist-cta__text">Request Styling Help</span>
    </span>
    <span class="stylist-cta__helper">Personal styling and made-to-measure guidance on WhatsApp</span>
  </a>
{%- endif -%}

{% stylesheet %}
  .stylist-cta {
    display: block;
    width: 100%;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .stylist-cta__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    width: 100%;
    min-height: var(--minimum-touch-target, 3.25em);
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg);
    border: var(--options-border-width, 1px) solid var(--color-variant-border, var(--color-border));
    border-radius: var(--options-border-radius, 0);
    background-color: transparent;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .stylist-cta__icon {
    flex: 0 0 auto;
    opacity: 0.85;
  }

  .stylist-cta:hover .stylist-cta__button {
    background-color: var(--color-variant-hover-background, var(--color-foreground));
    border-color: var(--color-variant-hover-border, var(--color-foreground));
    color: var(--color-variant-hover-text, var(--color-background));
  }

  .stylist-cta:focus-visible {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: var(--focus-outline-offset);
  }

  .stylist-cta__helper {
    display: block;
    margin-block-start: 0.6em;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    line-height: 1.4;
    color: var(--color-foreground);
    opacity: 0.6;
  }
{% endstylesheet %}
