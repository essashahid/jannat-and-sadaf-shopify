{%- doc -%}
  Renders the desktop mega menu as a vertical category rail on the left with a
  preview of products from the hovered category on the right.

  A rail item that has its own child links (a third menu level, e.g.
  SHOP > By Collection > Everyday Wear) renders as a plain-text group heading
  with its children listed beneath it as rail links. Every rail link gets its
  own product panel; triggers and panels share one running index.

  @param {object} parent_link - The top level link whose children build the rail.
  @param {string} id - Unique id used to scope the panel.

  @example
  {% render 'shop-mega-panel', parent_link: link, id: 'ShopMega-1' %}
{%- enddoc -%}

<div class="shop-mega" data-shop-mega="{{ id }}">
  <ul class="shop-mega__rail list-unstyled">
    {%- assign panel_index = 0 -%}
    {%- for child in parent_link.links -%}
      {%- if child.links != blank -%}
        {%- assign heading_id = id | append: '-group-' | append: forloop.index -%}
        <li class="shop-mega__rail-group">
          <span class="shop-mega__rail-heading" id="{{ heading_id }}">{{- child.title -}}</span>
          <ul class="shop-mega__rail-sublist list-unstyled" aria-labelledby="{{ heading_id }}">
            {%- for grandchild in child.links -%}
              <li class="shop-mega__rail-item">
                <a
                  href="{{ grandchild.url }}"
                  class="shop-mega__rail-link shop-mega__rail-link--nested{% if panel_index == 0 %} is-active{% endif %}"
                  data-shop-mega-trigger="{{ panel_index }}"
                >
                  <span class="wrap-text">{{- grandchild.title -}}</span>
                </a>
              </li>
              {%- assign panel_index = panel_index | plus: 1 -%}
            {%- endfor -%}
          </ul>
        </li>
      {%- else -%}
        {%- liquid
          assign is_clearance = false
          if child.url contains '/collections/special-prices'
            assign is_clearance = true
          endif
        -%}
        <li class="shop-mega__rail-item{% if is_clearance %} shop-mega__rail-item--divided{% endif %}">
          <a
            href="{{ child.url }}"
            class="shop-mega__rail-link{% if panel_index == 0 %} is-active{% endif %}"
            data-shop-mega-trigger="{{ panel_index }}"
          >
            <span class="wrap-text">{{- child.title -}}</span>
          </a>
        </li>
        {%- assign panel_index = panel_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </ul>

  <div class="shop-mega__panels">
    {%- assign panel_index = 0 -%}
    {%- for child in parent_link.links -%}
      {%- if child.links != blank -%}
        {%- for grandchild in child.links -%}
          {% render 'shop-mega-products', link: grandchild, index: panel_index %}
          {%- assign panel_index = panel_index | plus: 1 -%}
        {%- endfor -%}
      {%- else -%}
        {% render 'shop-mega-products', link: child, index: panel_index %}
        {%- assign panel_index = panel_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
