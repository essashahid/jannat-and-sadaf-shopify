{%- comment -%}
  Trunk Show promo popup. Render with {% render 'trunk-show-popup' %}.
  Auto-disables after the date below (server-side + client-side).
{%- endcomment -%}

{%- assign tsp_end_date = '2026-05-20' -%}
{%- assign tsp_today = 'now' | date: '%Y-%m-%d' -%}
{%- if tsp_today > tsp_end_date -%}{%- comment -%}past end date, render nothing{%- endcomment -%}{%- else -%}

<trunk-show-popup
  class="trunk-show-popup"
  data-storage-key="trunk-show-popup-2026-05-20-v2"
  data-end-date="2026-05-20"
  hidden
>
  <div class="trunk-show-popup__backdrop" data-tsp-close></div>

  <div
    class="trunk-show-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="trunk-show-popup-title"
  >
    <button
      type="button"
      class="trunk-show-popup__close"
      aria-label="Close"
      data-tsp-close
    >
      &times;
    </button>

    <div class="trunk-show-popup__inner">
      <p class="trunk-show-popup__eyebrow">@nichetrunkshow</p>

      <div class="trunk-show-popup__brand">
        <span class="trunk-show-popup__nl">NL</span>
        <p class="trunk-show-popup__brand-title">THE TRUNK SHOW</p>
        <p class="trunk-show-popup__brand-sub">BY NICHE LIFESTYLE</p>
      </div>

      <p class="trunk-show-popup__x">×</p>

      <p
        id="trunk-show-popup-title"
        class="trunk-show-popup__name"
      >
        JANNAT<br>&amp; SADAF
      </p>

      <div class="trunk-show-popup__details">
        <p class="trunk-show-popup__detail">
          <strong>Wed, 20 May 2026</strong>
        </p>
        <p class="trunk-show-popup__detail">
          12 Noon &ndash; 7 PM
        </p>
        <p class="trunk-show-popup__detail">
          Ejaz Art Gallery, Gulberg, Lahore
        </p>
      </div>

      <a
        class="trunk-show-popup__cta"
        href="https://maps.google.com/?q=Ejaz+Art+Gallery+Gulberg+Lahore"
        target="_blank"
        rel="noopener"
      >
        Get Directions
      </a>
    </div>
  </div>
</trunk-show-popup>

<style>
  .trunk-show-popup[hidden] { display: none; }
  .trunk-show-popup {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .trunk-show-popup__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    cursor: pointer;
  }
  .trunk-show-popup__dialog {
    position: relative;
    background: #ebe5d9;
    width: 100%;
    max-width: 460px;
    padding: 3rem 2rem 2.5rem;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
    text-align: center;
    font-family: var(--font-body--family, serif);
    color: #1a1a1a;
    animation: trunkShowPopupIn 0.35s ease;
  }
  @keyframes trunkShowPopupIn {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to   { opacity: 1; transform: none; }
  }
  .trunk-show-popup__close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    background: transparent;
    border: 0;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    color: #1a1a1a;
    padding: 0.25rem 0.5rem;
  }
  .trunk-show-popup__eyebrow {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    margin: 0;
    opacity: 0.7;
  }
  .trunk-show-popup__brand { margin: 1rem 0 0.5rem; }
  .trunk-show-popup__nl {
    font-family: var(--font-heading--family, serif);
    font-size: 4rem;
    font-weight: 400;
    color: #8a6d3b;
    letter-spacing: 0.05em;
    display: inline-block;
    line-height: 1;
  }
  .trunk-show-popup__brand-title {
    margin: 0.75rem 0 0.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: #6e5526;
  }
  .trunk-show-popup__brand-sub {
    margin: 0;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    color: #6e5526;
  }
  .trunk-show-popup__x {
    font-size: 1.5rem;
    margin: 1.25rem 0;
    color: #6e5526;
    letter-spacing: 0.1em;
  }
  .trunk-show-popup__name {
    font-family: var(--font-heading--family, serif);
    font-size: 2.4rem;
    line-height: 1;
    margin: 0 0 1.75rem;
    letter-spacing: 0.02em;
  }
  .trunk-show-popup__details {
    border-top: 1px solid rgba(110, 85, 38, 0.3);
    padding-top: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .trunk-show-popup__detail {
    margin: 0.35rem 0;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .trunk-show-popup__cta {
    display: inline-block;
    background: #1a1a1a;
    color: #ebe5d9;
    text-decoration: none;
    padding: 0.85rem 2rem;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border: 0;
  }
  .trunk-show-popup__cta:hover { background: #333; }
  @media (max-width: 500px) {
    .trunk-show-popup__dialog { padding: 2.5rem 1.5rem 2rem; }
    .trunk-show-popup__name { font-size: 1.9rem; }
    .trunk-show-popup__nl { font-size: 3rem; }
  }
</style>

<script>
  (function () {
    class TrunkShowPopup extends HTMLElement {
      connectedCallback() {
        const endDate = this.dataset.endDate;
        if (endDate) {
          const cutoff = new Date(endDate + 'T23:59:59');
          if (Date.now() > cutoff.getTime()) return;
        }
        const key = this.dataset.storageKey || 'trunk-show-popup';
        try {
          if (sessionStorage.getItem(key) === 'dismissed') return;
        } catch (e) {}

        setTimeout(() => {
          this.hidden = false;
          document.body.style.overflow = 'hidden';
        }, 600);

        this.addEventListener('click', (e) => {
          if (e.target.closest('[data-tsp-close]')) this.dismiss(key);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !this.hidden) this.dismiss(key);
        });
      }
      dismiss(key) {
        this.hidden = true;
        document.body.style.overflow = '';
        try { sessionStorage.setItem(key, 'dismissed'); } catch (e) {}
      }
    }
    if (!customElements.get('trunk-show-popup')) {
      customElements.define('trunk-show-popup', TrunkShowPopup);
    }
  })();
</script>

{%- endif -%}
