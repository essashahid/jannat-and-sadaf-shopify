<script>
  // Immediately ensure this section is visible — override luxury-animations.js
  (function() {
    var el = document.currentScript;
    if (el) {
      var parent = el.closest('.shopify-section');
      if (parent) {
        parent.classList.remove('luxury-animate');
        parent.classList.add('luxury-visible');
        parent.style.opacity = '1';
        parent.style.transform = 'none';
      }
    }
  })();
</script>

{{ 'sakatelier-home.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Jannat & Sadaf — editorial home page
  Quiet-luxury redesign built on the Horizon theme.
  Section order: Hero · Collection tiles · Bestsellers · Craft · Behind the
  scenes · Journal · Trust strip · Newsletter.
{%- endcomment -%}

{%- liquid
  assign hero_slides = section.blocks | where: 'type', 'hero_slide'
  assign bestseller_products = section.blocks | where: 'type', 'bestseller_product'
  assign fabric_items = section.blocks | where: 'type', 'fabric_collection'
  assign journal_items = section.blocks | where: 'type', 'journal_article'
-%}

{%- comment -%} ============ 1. HERO ============ {%- endcomment -%}
{%- liquid
  # Single full-bleed hero. The first hero block supplies the image and copy;
  # any further blocks are ignored so there is no carousel to sit through.
  assign hero = hero_slides | first
-%}
<section class="sak-section sak-hero" id="sak-hero" data-section-id="{{ section.id }}">
  <div class="sak-hero__media">
    {%- if section.settings.hero_video_enabled -%}
      {%- comment -%}
        Campaign film (vertical 9:16 source), shown on mobile only. The file is
        several megabytes, so the source is attached by script rather than in
        the markup: desktop never fetches it at all, and on mobile the poster
        paints first and the film is fetched once the page has finished
        loading. Skipped entirely on Save-Data, very slow connections, and for
        visitors who prefer reduced motion.
      {%- endcomment -%}
      <video
        class="sak-hero__video"
        loop
        muted
        playsinline
        preload="none"
        poster="{{ 'js-hero-motiya-poster.jpg' | asset_url }}"
        data-hero-film="{{ 'js-hero-motiya.mp4' | asset_url }}"
      ></video>
      <script>
        (function () {
          var video = document.currentScript.previousElementSibling;
          if (!video || !video.dataset.heroFilm) return;

          var mobile = window.matchMedia('(max-width: 767px)');
          var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
          var started = false;

          function tooExpensive() {
            var c = navigator.connection;
            if (!c) return false;
            return c.saveData === true || /^(slow-)?2g$/.test(c.effectiveType || '');
          }

          function start() {
            if (started || !mobile.matches || reducedMotion.matches || tooExpensive()) return;
            started = true;

            var source = document.createElement('source');
            source.src = video.dataset.heroFilm;
            source.type = 'video/mp4';
            video.appendChild(source);
            video.load();

            var played = video.play();
            if (played && played.catch) played.catch(function () {});
          }

          function schedule() {
            if (started || !mobile.matches) return;
            if ('requestIdleCallback' in window) {
              requestIdleCallback(start, { timeout: 2500 });
            } else {
              setTimeout(start, 1200);
            }
          }

          if (document.readyState === 'complete') schedule();
          else window.addEventListener('load', schedule, { once: true });

          if (mobile.addEventListener) mobile.addEventListener('change', schedule);
        })();
      </script>
    {%- endif -%}
    {%- if hero.settings.image != blank -%}
      <img
        src="{{ hero.settings.image | image_url: width: 2400 }}"
        srcset="{{ hero.settings.image | image_url: width: 900 }} 900w, {{ hero.settings.image | image_url: width: 1400 }} 1400w, {{ hero.settings.image | image_url: width: 1920 }} 1920w, {{ hero.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ hero.settings.image.alt | default: shop.name }}"
        loading="eager"
        fetchpriority="high"
        width="2400"
        height="1350"
      >
    {%- else -%}
      <img
        src="{{ 'hero-banner.jpg' | asset_url }}"
        alt="{{ shop.name }}"
        loading="eager"
        fetchpriority="high"
        width="1024"
        height="1024"
      >
    {%- endif -%}
  </div>

  <div class="sak-hero__overlay"></div>

  <div class="sak-hero__content" {{ hero.shopify_attributes }}>
    {%- if hero.settings.label != blank -%}
      <p class="sak-hero__label">{{ hero.settings.label }}</p>
    {%- endif -%}
    <h1 class="sak-hero__heading">{{ hero.settings.heading | default: shop.name }}</h1>
    {%- if hero.settings.subheading != blank -%}
      <p class="sak-hero__sub">{{ hero.settings.subheading }}</p>
    {%- endif -%}
    {%- if hero.settings.button_text != blank -%}
      <a href="{{ hero.settings.button_link | default: '/collections/all' }}" class="sak-hero__link">
        {{ hero.settings.button_text }}
      </a>
    {%- endif -%}
  </div>
</section>

{%- comment -%} ============ 2. COLLECTION TILES ============ {%- endcomment -%}
{%- if section.settings.show_fabrics -%}
  <section class="sak-section sak-tiles">
    <div class="sak-wrap">
      {%- if section.settings.fabrics_heading != blank -%}
        <div class="sak-head">
          <p class="sak-head__eyebrow">Explore</p>
          <h2 class="sak-head__title">{{ section.settings.fabrics_heading }}</h2>
          {%- if section.settings.fabrics_subtitle != blank -%}
            <p class="sak-head__sub">{{ section.settings.fabrics_subtitle }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="sak-tiles__grid">
        {%- if fabric_items.size > 0 -%}
          {%- for block in fabric_items -%}
            {%- liquid
              assign fabric_name_lower = block.settings.collection_name | downcase | strip
              assign fabric_asset = ''
              if fabric_name_lower == 'pret'
                assign fabric_asset = 'collection-pret.jpg'
              elsif fabric_name_lower == 'formals'
                assign fabric_asset = 'collection-formals.jpg'
              endif

              # Catalogue photo each tile falls back to when no image is set in the editor
              assign fabric_product = block.settings.source_product
              if fabric_product == blank
                if fabric_name_lower == 'pret'
                  assign fabric_product = all_products['serenade-beige']
                elsif fabric_name_lower == 'block print'
                  assign fabric_product = all_products['fuschia-angrakha']
                elsif fabric_name_lower == 'formals'
                  assign fabric_product = all_products['muted-iris']
                endif
              endif
              assign fabric_image = fabric_product.featured_image
            -%}
            <a href="{{ block.settings.collection_link | default: '/collections/all' }}" class="sak-tile" {{ block.shopify_attributes }}>
              <div class="sak-tile__media">
                {%- if block.settings.collection_image != blank -%}
                  <img src="{{ block.settings.collection_image | image_url: width: 1200 }}" alt="{{ block.settings.collection_name }}" loading="lazy" width="1200" height="1500">
                {%- elsif fabric_image != blank -%}
                  <img
                    src="{{ fabric_image | image_url: width: 1200 }}"
                    srcset="{{ fabric_image | image_url: width: 700 }} 700w, {{ fabric_image | image_url: width: 1000 }} 1000w, {{ fabric_image | image_url: width: 1400 }} 1400w"
                    sizes="33vw"
                    alt="{{ block.settings.collection_name }}"
                    loading="lazy"
                  >
                {%- elsif fabric_asset != '' -%}
                  <img src="{{ fabric_asset | asset_url }}" alt="{{ block.settings.collection_name }}" loading="lazy">
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'sak-tile__placeholder' }}
                {%- endif -%}
              </div>
              <div class="sak-tile__body">
                <h3 class="sak-tile__name">{{ block.settings.collection_name | default: 'Collection' }}</h3>
              </div>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.fabrics_button_text != blank -%}
        <div class="sak-head__action">
          <a href="{{ section.settings.fabrics_button_link | default: '/collections' }}" class="sak-btn sak-btn--dark">
            <span>{{ section.settings.fabrics_button_text }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{%- comment -%} ============ 3. BESTSELLERS / NEW ARRIVALS ============ {%- endcomment -%}
{%- if section.settings.show_bestsellers -%}
  {%- liquid
    assign bs_collection = collections[section.settings.bestsellers_collection]
    unless bs_collection and bs_collection.products.size > 0
      assign bs_collection = collections['all']
    endunless
  -%}
  <section class="sak-section sak-products">
    <div class="sak-wrap">
      <div class="sak-head">
        <p class="sak-head__eyebrow">Editors' Picks</p>
        <h2 class="sak-head__title">{{ section.settings.bestsellers_heading | default: 'New Arrivals' }}</h2>
        {%- if section.settings.bestsellers_subtitle != blank -%}
          <p class="sak-head__sub">{{ section.settings.bestsellers_subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="sak-products__grid">
        {%- if bestseller_products.size > 0 -%}
          {%- for block in bestseller_products limit: 8 -%}
            <a href="{{ block.settings.product_link | default: '#' }}" class="sak-product" {{ block.shopify_attributes }}>
              <div class="sak-product__media">
                {%- if block.settings.product_image != blank -%}
                  <img src="{{ block.settings.product_image | image_url: width: 600 }}" alt="{{ block.settings.product_name }}" loading="lazy">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'sak-product__placeholder' }}
                {%- endif -%}
              </div>
              <div class="sak-product__info">
                <h3 class="sak-product__name">{{ block.settings.product_name | default: 'Product' }}</h3>
                <p class="sak-product__price">{{ block.settings.product_price }}</p>
              </div>
            </a>
          {%- endfor -%}
        {%- elsif bs_collection.products.size > 0 -%}
          {%- assign sorted_bs_products = bs_collection.products | sort: 'created_at' | reverse -%}
          {%- for product in sorted_bs_products limit: 8 -%}
            <a href="{{ product.url }}" class="sak-product">
              <div class="sak-product__media">
                {%- unless product.available -%}
                  <span class="sak-badge sak-badge--soldout">Sold Out</span>
                {%- endunless -%}
                {%- if product.featured_media -%}
                  <img class="sak-product__img sak-product__img--primary" src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.title }}" loading="lazy" width="600" height="800">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'sak-product__placeholder' }}
                {%- endif -%}
                {%- if product.media[1] -%}
                  <img class="sak-product__img sak-product__img--hover" src="{{ product.media[1] | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="800">
                {%- endif -%}
              </div>
              <div class="sak-product__info">
                <h3 class="sak-product__name">{{ product.title }}</h3>
                <p class="sak-product__price">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="sak-product__price--sale">{{ product.price | money }}</span>
                    <s class="sak-product__price--was">{{ product.compare_at_price | money }}</s>
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </p>
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <p class="sak-products__empty">Connect a collection in the theme editor to feature products here.</p>
        {%- endif -%}
      </div>

      {%- if section.settings.bestsellers_button_text != blank -%}
        <div class="sak-head__action">
          <a href="{{ section.settings.bestsellers_button_link | default: '/collections/all' }}" class="sak-btn sak-btn--dark">
            <span>{{ section.settings.bestsellers_button_text }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{%- comment -%} ============ FEATURED PRODUCT SPOTLIGHT ============ {%- endcomment -%}
{%- if section.settings.show_spotlight -%}
  {%- assign spotlight_product = section.settings.spotlight_product -%}
  {%- if spotlight_product != blank -%}
    <section class="sak-section sak-spotlight">
      <div class="sak-spotlight__inner">
        <div class="sak-spotlight__media">
          <a href="{{ spotlight_product.url }}" aria-label="{{ spotlight_product.title }}">
            {%- if section.settings.spotlight_image != blank -%}
              <img
                src="{{ section.settings.spotlight_image | image_url: width: 1200 }}"
                srcset="{{ section.settings.spotlight_image | image_url: width: 600 }} 600w, {{ section.settings.spotlight_image | image_url: width: 900 }} 900w, {{ section.settings.spotlight_image | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 990px) 50vw, 100vw"
                alt="{{ spotlight_product.title }}"
                loading="lazy"
                width="1200"
                height="1500"
              >
            {%- elsif spotlight_product.featured_media -%}
              <img
                src="{{ spotlight_product.featured_media | image_url: width: 1200 }}"
                srcset="{{ spotlight_product.featured_media | image_url: width: 600 }} 600w, {{ spotlight_product.featured_media | image_url: width: 900 }} 900w, {{ spotlight_product.featured_media | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 990px) 50vw, 100vw"
                alt="{{ spotlight_product.title }}"
                loading="lazy"
                width="1200"
                height="1500"
              >
            {%- endif -%}
          </a>
          {%- if section.settings.spotlight_eyebrow != blank -%}
            <span class="sak-spotlight__badge">{{ section.settings.spotlight_eyebrow }}</span>
          {%- endif -%}
        </div>
        <div class="sak-spotlight__content">
          {%- if section.settings.spotlight_subtitle != blank -%}
            <p class="sak-spotlight__sub">{{ section.settings.spotlight_subtitle }}</p>
          {%- endif -%}
          <h2 class="sak-spotlight__title">
            <a href="{{ spotlight_product.url }}">{{ spotlight_product.title }}</a>
          </h2>
          {%- unless spotlight_product.price == 0 -%}
            <p class="sak-spotlight__price">
              {%- if spotlight_product.compare_at_price > spotlight_product.price -%}
                <span class="sak-spotlight__price--sale">{{ spotlight_product.price | money }}</span>
                <s class="sak-spotlight__price--strike">{{ spotlight_product.compare_at_price | money }}</s>
              {%- else -%}
                {{ spotlight_product.price | money }}
              {%- endif -%}
            </p>
          {%- endunless -%}
          {%- if section.settings.spotlight_body != blank -%}
            <p class="sak-spotlight__body">{{ section.settings.spotlight_body }}</p>
          {%- endif -%}
          <a href="{{ spotlight_product.url }}" class="sak-btn sak-btn--dark sak-spotlight__cta">
            <span>{{ section.settings.spotlight_button | default: 'Shop the Piece' }}</span>
          </a>
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{%- comment -%} ============ MARQUEE STRIP ============ {%- endcomment -%}
<section class="sak-section sak-marquee" aria-hidden="true">
  <div class="sak-marquee__track">
    {%- assign marquee_items = 'Jannat &amp; Sadaf,Atelier,Handcrafted in Pakistan' | split: ',' -%}
    {%- for cycle in (1..3) -%}
      {%- for item in marquee_items -%}
        <span class="sak-marquee__item">{{ item }}</span>
        <span class="sak-marquee__sep">&#x2022;</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%} ============ 4. CRAFT / AT THE STUDIO ============ {%- endcomment -%}
{%- if section.settings.show_atelier -%}
  <section class="sak-section sak-craft">
    <div class="sak-craft__inner">
      <div class="sak-craft__media">
        {%- if section.settings.atelier_image != blank -%}
          {%- assign atelier_poster = section.settings.atelier_image | image_url: width: 1100 -%}
        {%- else -%}
          {%- assign atelier_poster = section.settings.atelier_video_poster -%}
        {%- endif -%}
        {%- if section.settings.atelier_video != blank -%}
          {{ section.settings.atelier_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', poster: atelier_poster }}
        {%- elsif section.settings.atelier_video_url != blank -%}
          <video
            class="sak-craft__video"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            disablepictureinpicture
            aria-label="{{ section.settings.atelier_heading | default: 'Handcrafted With Care' }}"
            {% if atelier_poster != blank %}poster="{{ atelier_poster }}"{% endif %}
            width="1280"
            height="720"
          >
            <source src="{{ section.settings.atelier_video_url }}" type="video/mp4">
          </video>
        {%- elsif section.settings.atelier_image != blank -%}
          <img src="{{ section.settings.atelier_image | image_url: width: 1100 }}" alt="{{ section.settings.atelier_heading | default: 'At the Studio' }}" loading="lazy" width="1100" height="1300">
        {%- else -%}
          <img src="{{ 'atelier-banner.jpg' | asset_url }}" alt="{{ section.settings.atelier_heading | default: 'At the Studio' }}" loading="lazy" width="1024" height="1024">
        {%- endif -%}
      </div>
      <div class="sak-craft__content">
        {%- if section.settings.atelier_subtitle != blank -%}
          <p class="sak-head__eyebrow">{{ section.settings.atelier_subtitle }}</p>
        {%- endif -%}
        <h2 class="sak-craft__heading">{{ section.settings.atelier_heading | default: 'Handcrafted With Care' }}</h2>
        <p class="sak-craft__body">
          {{- section.settings.atelier_body | default: 'Every Jannat & Sadaf piece is shaped slowly — hand embroidery, traditional techniques, and a quiet attention to detail that machines cannot replicate. We believe in fewer, finer things.' -}}
        </p>
        {%- if section.settings.atelier_button_text != blank -%}
          <a href="{{ section.settings.atelier_button_link | default: '/pages/behind-the-scenes-our-craft' }}" class="sak-btn sak-btn--dark">
            <span>{{ section.settings.atelier_button_text }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} ============ 5. BEHIND THE SCENES ============ {%- endcomment -%}
{%- if section.settings.show_bts -%}
  <section class="sak-section sak-bts">
    <div class="sak-wrap">
      <div class="sak-head">
        <p class="sak-head__eyebrow">In the Making</p>
        <h2 class="sak-head__title">{{ section.settings.bts_heading | default: 'Behind the Scenes' }}</h2>
        {%- if section.settings.bts_subtitle != blank -%}
          <p class="sak-head__sub">{{ section.settings.bts_subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="sak-bts__grid">
        {%- assign bts_default_captions = 'Hand embroidery,Fabric selection,Finishing details' | split: ',' -%}
        {%- for i in (1..3) -%}
          {%- assign img_key = 'bts_detail_' | append: i -%}
          {%- assign cap_key = 'bts_caption_' | append: i -%}
          {%- assign bts_img = section.settings[img_key] -%}
          {%- assign bts_cap = section.settings[cap_key] | default: bts_default_captions[forloop.index0] -%}
          <figure class="sak-bts__item">
            <div class="sak-bts__media">
              {%- if bts_img != blank -%}
                <img src="{{ bts_img | image_url: width: 700 }}" alt="{{ bts_cap }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'bts-embroidery-' | append: i | append: '.jpg' | asset_url }}" alt="{{ bts_cap }}" loading="lazy">
              {%- endif -%}
            </div>
            <figcaption class="sak-bts__caption">{{ bts_cap }}</figcaption>
          </figure>
        {%- endfor -%}
      </div>

      {%- if section.settings.bts_description != blank -%}
        <p class="sak-bts__description">{{ section.settings.bts_description }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{%- comment -%} ============ 6. JOURNAL ============ {%- endcomment -%}
{%- if section.settings.show_journal -%}
  <section class="sak-section sak-journal">
    <div class="sak-wrap">
      <div class="sak-head">
        <p class="sak-head__eyebrow">Stories</p>
        <h2 class="sak-head__title">{{ section.settings.journal_heading | default: 'In the Journal' }}</h2>
        {%- if section.settings.journal_subtitle != blank -%}
          <p class="sak-head__sub">{{ section.settings.journal_subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="sak-journal__grid">
        {%- if section.settings.journal_blog != blank -%}
          {%- assign journal_blog = blogs[section.settings.journal_blog] -%}
          {%- for article in journal_blog.articles limit: 3 -%}
            <a href="{{ article.url }}" class="sak-journal__card">
              <div class="sak-journal__media">
                {%- if article.image != blank -%}
                  <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title }}" loading="lazy">
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'sak-journal__placeholder' }}
                {%- endif -%}
              </div>
              <p class="sak-journal__meta">{{ article.published_at | date: '%B %Y' }}</p>
              <h3 class="sak-journal__title">{{ article.title }}</h3>
              <p class="sak-journal__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
              <span class="sak-journal__more">Read More</span>
            </a>
          {%- endfor -%}
        {%- elsif journal_items.size > 0 -%}
          {%- for block in journal_items limit: 3 -%}
            <a href="{{ block.settings.article_link | default: '#' }}" class="sak-journal__card" {{ block.shopify_attributes }}>
              <div class="sak-journal__media">
                {%- if block.settings.article_image != blank -%}
                  <img src="{{ block.settings.article_image | image_url: width: 700 }}" alt="{{ block.settings.article_title }}" loading="lazy">
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'sak-journal__placeholder' }}
                {%- endif -%}
              </div>
              <p class="sak-journal__meta">{{ block.settings.article_date | default: 'Journal' }}</p>
              <h3 class="sak-journal__title">{{ block.settings.article_title | default: 'Article Title' }}</h3>
              {%- if block.settings.article_excerpt != blank -%}
                <p class="sak-journal__excerpt">{{ block.settings.article_excerpt }}</p>
              {%- endif -%}
              <span class="sak-journal__more">Read More</span>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.journal_button_text != blank -%}
        <div class="sak-head__action">
          <a href="{{ section.settings.journal_button_link | default: '/blogs/news' }}" class="sak-btn sak-btn--dark">
            <span>{{ section.settings.journal_button_text }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{%- comment -%} ============ 7. TRUST STRIP ============ {%- endcomment -%}
{%- if section.settings.show_policies -%}
  <section class="sak-section sak-trust">
    <div class="sak-wrap">
      <div class="sak-trust__grid">
        {%- for i in (1..4) -%}
          {%- assign t_title = 'policy_' | append: i | append: '_title' -%}
          {%- assign t_text = 'policy_' | append: i | append: '_text' -%}
          {%- assign t_link = 'policy_' | append: i | append: '_link' -%}
          {%- assign title_val = section.settings[t_title] -%}
          {%- if title_val != blank -%}
            <div class="sak-trust__item">
              <div class="sak-trust__icon">
                {%- case i -%}
                  {%- when 1 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- when 2 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/></svg>
                  {%- when 3 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><rect x="2" y="5" width="20" height="14" rx="1.5"/><path d="M2 10h20"/><path d="M6 15h5"/></svg>
                {%- endcase -%}
              </div>
              <h3 class="sak-trust__title">{{ title_val }}</h3>
              {%- assign text_val = section.settings[t_text] -%}
              {%- if text_val != blank -%}
                <p class="sak-trust__text">{{ text_val }}</p>
              {%- endif -%}
              {%- assign link_val = section.settings[t_link] -%}
              {%- if link_val != blank -%}
                <a href="{{ link_val }}" class="sak-trust__link">Learn More</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} ============ 8. NEWSLETTER ============ {%- endcomment -%}
{%- if section.settings.show_newsletter -%}
  <section class="sak-section sak-news">
    <div class="sak-news__inner">
      <p class="sak-head__eyebrow">Newsletter</p>
      <h2 class="sak-news__heading">{{ section.settings.newsletter_heading | default: 'Join the Jannat & Sadaf List' }}</h2>
      <p class="sak-news__text">
        {{- section.settings.newsletter_text | default: 'Be the first to discover new collections, styling notes, and early access.' -}}
      </p>
      {%- form 'customer', class: 'sak-news__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="sak-news__success">Thank you — you're on the list.</p>
        {%- else -%}
          <label class="sak-visually-hidden" for="sak-news-email">Email address</label>
          <input
            type="email"
            id="sak-news-email"
            name="contact[email]"
            class="sak-news__field"
            placeholder="Your email address"
            autocomplete="email"
            required
          >
          <button type="submit" class="sak-btn sak-btn--cream sak-news__submit"><span>Subscribe</span></button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </section>
{%- endif -%}


