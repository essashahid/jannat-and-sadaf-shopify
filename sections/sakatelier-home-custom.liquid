      </div>
      <div class="sak-policies__divider"></div>
      <div class="sak-policies__item">
        <div class="sak-policies__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        </div>
        <h4>{{ section.settings.policy_3_title | default: 'Shipping & Handling' }}</h4>
        <a href="{{ section.settings.policy_3_link | default: '/pages/shipping-handling' }}" class="sak-policies__link">Learn More</a>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

<!-- =============================================
     HERO SLIDESHOW JAVASCRIPT
     ============================================= -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const hero = document.getElementById('sak-hero');
    if (!hero) return;

    const slides = hero.querySelectorAll('.sak-hero__slide');
    const dots = hero.querySelectorAll('.sak-hero__dot');
    const content = hero.querySelector('.sak-hero__content');
    if (slides.length <= 1) return;

    let current = 0;
    let interval;

    function goToSlide(index) {
      slides[current].classList.remove('is-active');
      if (dots[current]) dots[current].classList.remove('is-active');
      current = (index + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      if (dots[current]) dots[current].classList.add('is-active');

      // Update hero content from slide data
      const slideData = [
        {%- for block in hero_slides -%}
          {
            "label": {{ block.settings.label | default: '' | json }},
            "heading": {{ block.settings.heading | default: '' | json }},
            "subheading": {{ block.settings.subheading | default: '' | json }},
            "button_text": {{ block.settings.button_text | default: '' | json }},
            "button_link": {{ block.settings.button_link | default: '/collections/all' | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ];
      if (slideData[current]) {
        const d = slideData[current];
        const labelEl = content.querySelector('.sak-label');
        const h1El = content.querySelector('h1');
        const subEl = content.querySelector('.sak-hero-sub');

        if (labelEl) labelEl.textContent = d.label;
        if (h1El) h1El.textContent = d.heading;
        if (subEl) subEl.textContent = d.subheading;
      }
    }

    function nextSlide() { goToSlide(current + 1); }
    function prevSlide() { goToSlide(current - 1); }

    function startAutoplay() {
      interval = setInterval(nextSlide, 5000);
    }

    function stopAutoplay() {
      clearInterval(interval);
    }

    // Navigation buttons
    const prevBtn = hero.querySelector('[data-hero-prev]');
    const nextBtn = hero.querySelector('[data-hero-next]');
    if (prevBtn) prevBtn.addEventListener('click', function () { stopAutoplay(); prevSlide(); startAutoplay(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { stopAutoplay(); nextSlide(); startAutoplay(); });

    // Dots
    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        stopAutoplay();
        goToSlide(i);
        startAutoplay();
      });
    });

    startAutoplay();
  });
</script>

