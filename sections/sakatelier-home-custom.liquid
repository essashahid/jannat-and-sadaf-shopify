      </div>
      <div class="sak-policies__divider"></div>
      <div class="sak-policies__item">
        <div class="sak-policies__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        </div>
        <h4>{{ section.settings.policy_2_title | default: 'Exchange & Refund Policy' }}</h4>
