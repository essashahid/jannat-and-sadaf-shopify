<script>
  // Immediately ensure this section is visible — override luxury-animations.js
  (function() {
    var el = document.currentScript;
    if (el) {
      var parent = el.closest('.shopify-section');
      if (parent) {
        parent.classList.remove('luxury-animate');
        parent.classList.add('luxury-visible');
        parent.style.opacity = '1';
        parent.style.transform = 'none';
      }
    }
  })();
</script>

{{ 'sakatelier-home.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  SAK Home — sakatelier.com inspired home page section
  Built for the Jannat & Sadaf Shopify theme (Horizon)
{%- endcomment -%}

{%- liquid
  assign hero_slides = section.blocks | where: "type", "hero_slide"
  assign bestseller_products = section.blocks | where: "type", "bestseller_product"
  assign seen_on_items = section.blocks | where: "type", "seen_on_person"
  assign fabric_items = section.blocks | where: "type", "fabric_collection"
  assign journal_items = section.blocks | where: "type", "journal_article"
-%}

<!-- =============================================
     1. HERO SLIDESHOW
     ============================================= -->
<section class="sak-section sak-hero" id="sak-hero" data-section-id="{{ section.id }}">
  <div class="sak-hero__slides">
    {%- for block in hero_slides -%}
      <div class="sak-hero__slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1920 }}"
            alt="{{ block.settings.image.alt | default: block.settings.heading }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="1920"
            height="900"
          >
        {%- else -%}
          <img
            src="{{ 'hero-slide-' | append: forloop.index | append: '.png' | asset_url }}"
            alt="{{ block.settings.heading | default: 'Hero' }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="1920"
            height="900"
          >
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="sak-hero__overlay"></div>

  <div class="sak-hero__content">
    {%- assign active_slide = hero_slides | first -%}
    {%- if active_slide.settings.label != blank -%}
      <p class="sak-label">{{ active_slide.settings.label }}</p>
    {%- endif -%}
    {%- if active_slide.settings.heading != blank -%}
      <h1>{{ active_slide.settings.heading }}</h1>
    {%- endif -%}
    {%- if active_slide.settings.subheading != blank -%}
      <p class="sak-hero-sub">{{ active_slide.settings.subheading }}</p>
    {%- endif -%}
    {%- if active_slide.settings.button_text != blank -%}
      <a href="{{ active_slide.settings.button_link | default: '/collections/all' }}" class="sak-btn sak-btn--light">
        <span>{{ active_slide.settings.button_text }}</span>
      </a>
    {%- endif -%}
  </div>

  {%- if hero_slides.size > 1 -%}
    <div class="sak-hero__nav sak-hero__nav--left">
      <button class="sak-hero__arrow" data-hero-prev aria-label="Previous slide">&#8592;</button>
    </div>
    <div class="sak-hero__nav sak-hero__nav--right">
      <button class="sak-hero__arrow" data-hero-next aria-label="Next slide">&#8594;</button>
    </div>
    <div class="sak-hero__dots">
      {%- for block in hero_slides -%}
        <button class="sak-hero__dot {% if forloop.first %}is-active{% endif %}" data-hero-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<!-- =============================================
     2. FEATURED PRODUCT / IMAGE COMPARISON
     ============================================= -->
{%- if section.settings.show_comparison -%}
<section class="sak-section sak-comparison">
  <div class="sak-content-width">
    <div class="sak-section-header">
      <h2>{{ section.settings.comparison_heading | default: 'Featured' }}</h2>
      {%- if section.settings.comparison_subtitle != blank -%}
        <p class="sak-subtitle">{{ section.settings.comparison_subtitle }}</p>
      {%- endif -%}
    </div>
    <div class="sak-comparison__inner">
      <div class="sak-comparison__side">
        {%- if section.settings.comparison_image_left != blank -%}
          <img
            src="{{ section.settings.comparison_image_left | image_url: width: 800 }}"
            alt="{{ section.settings.comparison_label_left | default: 'Option 1' }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        <div class="sak-comparison__label">
          <span>{{ section.settings.comparison_label_left | default: 'Noir' }}</span>
        </div>
      </div>
      <div class="sak-comparison__divider"></div>
      <div class="sak-comparison__side">
        {%- if section.settings.comparison_image_right != blank -%}
          <img
            src="{{ section.settings.comparison_image_right | image_url: width: 800 }}"
            alt="{{ section.settings.comparison_label_right | default: 'Option 2' }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        <div class="sak-comparison__label">
          <span>{{ section.settings.comparison_label_right | default: 'Ivory' }}</span>
        </div>
      </div>
    </div>
    <div class="sak-comparison__info">
      <h3>{{ section.settings.comparison_product_name | default: 'The Signature Set' }}</h3>
      <p>{{ section.settings.comparison_product_price | default: 'PKR 12,500' }}</p>
      {%- if section.settings.comparison_button_text != blank -%}
        <a href="{{ section.settings.comparison_button_link | default: '/collections/all' }}" class="sak-btn">
          <span>{{ section.settings.comparison_button_text }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

<!-- =============================================
     3. AT THE ATELIER BANNER
     ============================================= -->
{%- if section.settings.show_atelier -%}
<section class="sak-section sak-atelier">
  {%- if section.settings.atelier_image != blank -%}
    <img
      src="{{ section.settings.atelier_image | image_url: width: 1920 }}"
      alt="{{ section.settings.atelier_heading | default: 'At the Atelier' }}"
      class="sak-atelier__bg"
      loading="lazy"
      width="1920"
      height="600"
    >
  {%- else -%}
    <img
      src="{{ 'atelier-banner.png' | asset_url }}"
      alt="{{ section.settings.atelier_heading | default: 'At the Atelier' }}"
      class="sak-atelier__bg"
      loading="lazy"
      width="1920"
      height="600"
    >
  {%- endif -%}
  <div class="sak-atelier__overlay">
    <h2>{{ section.settings.atelier_heading | default: 'At the Atelier' }}</h2>
    {%- if section.settings.atelier_subtitle != blank -%}
      <p class="sak-atelier-sub">{{ section.settings.atelier_subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.atelier_button_text != blank -%}
      <a href="{{ section.settings.atelier_button_link | default: '/pages/about' }}" class="sak-btn sak-btn--light">
        <span>{{ section.settings.atelier_button_text }}</span>
      </a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<!-- =============================================
     BEHIND THE SCENES
     ============================================= -->
{%- if section.settings.show_bts -%}
<section class="sak-section sak-bts">
  <div class="sak-content-width">
    <div class="sak-section-header">
      <h2>{{ section.settings.bts_heading | default: 'Behind The Scenes' }}</h2>
      {%- if section.settings.bts_subtitle != blank -%}
        <p class="sak-subtitle">{{ section.settings.bts_subtitle }}</p>
      {%- endif -%}
    </div>
    <div class="sak-bts__grid">
      <div class="sak-bts__item">
        {%- if section.settings.bts_detail_1 != blank -%}
          <img src="{{ section.settings.bts_detail_1 | image_url: width: 600 }}" alt="Craft detail" loading="lazy">
        {%- else -%}
          <img src="{{ 'bts-embroidery-1.jpg' | asset_url }}" alt="Zardozi embroidery on purple fabric" loading="lazy">
        {%- endif -%}
      </div>
      <div class="sak-bts__item">
        {%- if section.settings.bts_detail_2 != blank -%}
          <img src="{{ section.settings.bts_detail_2 | image_url: width: 600 }}" alt="Craft detail" loading="lazy">
        {%- else -%}
          <img src="{{ 'bts-embroidery-2.jpg' | asset_url }}" alt="Gold thread work in progress" loading="lazy">
        {%- endif -%}
      </div>
      <div class="sak-bts__item">
        {%- if section.settings.bts_detail_3 != blank -%}
          <img src="{{ section.settings.bts_detail_3 | image_url: width: 600 }}" alt="Craft detail" loading="lazy">
        {%- else -%}
          <img src="{{ 'bts-embroidery-3.jpg' | asset_url }}" alt="Traditional paisley embroidery" loading="lazy">
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.bts_description != blank -%}
      <p class="sak-bts__description">{{ section.settings.bts_description }}</p>
    {%- else -%}
      <p class="sak-bts__description">Every piece begins as a vision — brought to life through hours of meticulous hand-embroidery, traditional techniques passed down through generations, and an unwavering commitment to perfection.</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<!-- =============================================
     4. BEST SELLERS
     ============================================= -->
{%- if section.settings.show_bestsellers -%}
<section class="sak-section sak-bestsellers">
  <div class="sak-content-width">
    <div class="sak-section-header">
      <h2>{{ section.settings.bestsellers_heading | default: 'Best Sellers' }}</h2>
      {%- if section.settings.bestsellers_subtitle != blank -%}
        <p class="sak-subtitle">{{ section.settings.bestsellers_subtitle }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.bestsellers_collection != blank -%}
      {%- assign bs_collection = collections[section.settings.bestsellers_collection] -%}
      <div class="sak-bestsellers__grid">
        {%- for product in bs_collection.products limit: 4 -%}
          <a href="{{ product.url }}" class="sak-bestsellers__card sak-animate sak-animate--delay-{{ forloop.index }}">
            <div class="sak-bestsellers__card-img">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.title }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {%- else -%}
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="sak-bestsellers__card-info">
              <h4>{{ product.title }}</h4>
              <p class="sak-price">{{ product.price | money }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- elsif bestseller_products.size > 0 -%}
      <div class="sak-bestsellers__grid">
        {%- for block in bestseller_products limit: 4 -%}
          <a href="{{ block.settings.product_link | default: '#' }}" class="sak-bestsellers__card sak-animate sak-animate--delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="sak-bestsellers__card-img">
              {%- if block.settings.product_image != blank -%}
                <img
                  src="{{ block.settings.product_image | image_url: width: 600 }}"
                  alt="{{ block.settings.product_name | default: 'Product' }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {%- else -%}
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="sak-bestsellers__card-info">
              <h4>{{ block.settings.product_name | default: 'Product Name' }}</h4>
              <p class="sak-price">{{ block.settings.product_price | default: 'PKR 0' }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="sak-bestsellers__grid">
        {%- for i in (1..4) -%}
          <div class="sak-bestsellers__card sak-animate sak-animate--delay-{{ i }}">
            <div class="sak-bestsellers__card-img">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="sak-bestsellers__card-info">
              <h4>Product {{ i }}</h4>
              <p class="sak-price">PKR 12,500</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="sak-bestsellers__nav">
      <button class="sak-bestsellers__nav-btn" aria-label="Previous">&#8592;</button>
      <button class="sak-bestsellers__nav-btn" aria-label="Next">&#8594;</button>
    </div>
  </div>
</section>
{%- endif -%}

<!-- =============================================
     5. AS SEEN ON
     ============================================= -->
{%- if section.settings.show_seenon -%}
<section class="sak-section sak-seenon">
  <div class="sak-content-width">
    <div class="sak-section-header">
      <h2>{{ section.settings.seenon_heading | default: 'As Seen On' }}</h2>
      {%- if section.settings.seenon_subtitle != blank -%}
        <p class="sak-subtitle">{{ section.settings.seenon_subtitle }}</p>
      {%- endif -%}
    </div>
    <div class="sak-seenon__grid">
      {%- if seen_on_items.size > 0 -%}
        {%- for block in seen_on_items -%}
          <a href="{{ block.settings.profile_link | default: '#' }}" class="sak-seenon__item" {{ block.shopify_attributes }}>
            <div class="sak-seenon__avatar">
              {%- if block.settings.avatar != blank -%}
                <img
                  src="{{ block.settings.avatar | image_url: width: 300 }}"
                  alt="{{ block.settings.name | default: 'Featured' }}"
                  loading="lazy"
                  width="130"
                  height="130"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="sak-seenon__name">{{ block.settings.name | default: '@username' }}</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}
          <div class="sak-seenon__item">
            <div class="sak-seenon__avatar">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <span class="sak-seenon__name">@featured{{ i }}</span>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

<!-- =============================================
     6. FABRICS / COLLECTIONS
     ============================================= -->
{%- if section.settings.show_fabrics -%}
<section class="sak-section sak-fabrics">
  <div class="sak-content-width">
    <div class="sak-section-header">
      <h2>{{ section.settings.fabrics_heading | default: 'Our Collections' }}</h2>
      {%- if section.settings.fabrics_subtitle != blank -%}
        <p class="sak-subtitle">{{ section.settings.fabrics_subtitle }}</p>
      {%- endif -%}
    </div>
    <div class="sak-fabrics__grid">
      {%- if fabric_items.size > 0 -%}
        {%- for block in fabric_items -%}
          {%- liquid
            assign fabric_asset = ''
            assign fabric_name_lower = block.settings.collection_name | downcase
            if fabric_name_lower == 'pret'
              assign fabric_asset = 'collection-pret.jpg'
            elsif fabric_name_lower == 'formals'
              assign fabric_asset = 'collection-formals.jpg'
            endif
          -%}
          <a href="{{ block.settings.collection_link | default: '#' }}" class="sak-fabrics__card" {{ block.shopify_attributes }}>
            {%- if block.settings.collection_image != blank -%}
              <img
                src="{{ block.settings.collection_image | image_url: width: 800 }}"
                alt="{{ block.settings.collection_name | default: 'Collection' }}"
                loading="lazy"
              >
            {%- elsif fabric_asset != '' -%}
              <img
                src="{{ fabric_asset | asset_url }}"
                alt="{{ block.settings.collection_name | default: 'Collection' }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <div class="sak-fabrics__card-overlay">
              <h4>{{ block.settings.collection_name | default: 'Collection' }}</h4>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <a href="#" class="sak-fabrics__card">
          <img src="{{ 'collection-pret.jpg' | asset_url }}" alt="Pret" loading="lazy">
          <div class="sak-fabrics__card-overlay">
            <h4>Pret</h4>
          </div>
        </a>
        <a href="#" class="sak-fabrics__card">
          <img src="{{ 'collection-formals.jpg' | asset_url }}" alt="Formals" loading="lazy">
          <div class="sak-fabrics__card-overlay">
            <h4>Formals</h4>
          </div>
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.fabrics_button_text != blank -%}
      <div class="sak-fabrics__action">
        <a href="{{ section.settings.fabrics_button_link | default: '/collections' }}" class="sak-btn">
          <span>{{ section.settings.fabrics_button_text }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<!-- =============================================
     7. IN THE JOURNAL
     ============================================= -->
{%- if section.settings.show_journal -%}
<section class="sak-section sak-journal">
  <div class="sak-content-width">
    <div class="sak-section-header">
      <h2>{{ section.settings.journal_heading | default: 'In The Journal' }}</h2>
      {%- if section.settings.journal_subtitle != blank -%}
        <p class="sak-subtitle">{{ section.settings.journal_subtitle }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.journal_blog != blank -%}
      {%- assign journal_blog = blogs[section.settings.journal_blog] -%}
      <div class="sak-journal__grid">
        {%- for article in journal_blog.articles limit: 3 -%}
          <a href="{{ article.url }}" class="sak-journal__card">
            <div class="sak-journal__card-img">
              {%- if article.image != blank -%}
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  alt="{{ article.title }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <p class="sak-journal__card-meta">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <h4>{{ article.title }}</h4>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 100 }}</p>
          </a>
        {%- endfor -%}
      </div>
    {%- elsif journal_items.size > 0 -%}
      <div class="sak-journal__grid">
        {%- for block in journal_items limit: 3 -%}
          <a href="{{ block.settings.article_link | default: '#' }}" class="sak-journal__card" {{ block.shopify_attributes }}>
            <div class="sak-journal__card-img">
              {%- if block.settings.article_image != blank -%}
                <img
                  src="{{ block.settings.article_image | image_url: width: 600 }}"
                  alt="{{ block.settings.article_title | default: 'Article' }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <p class="sak-journal__card-meta">{{ block.settings.article_date | default: 'January 2026' }}</p>
            <h4>{{ block.settings.article_title | default: 'Article Title' }}</h4>
            <p>{{ block.settings.article_excerpt | default: 'Read more about our latest updates and behind-the-scenes stories.' }}</p>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="sak-journal__grid">
        {%- for i in (1..3) -%}
          <div class="sak-journal__card">
            <div class="sak-journal__card-img">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <p class="sak-journal__card-meta">February 2026</p>
            <h4>Behind the Scenes: Our Craft</h4>
            <p>Discover the artistry and attention to detail behind every piece.</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.journal_button_text != blank -%}
      <div class="sak-journal__action">
        <a href="{{ section.settings.journal_button_link | default: '/blogs' }}" class="sak-btn">
          <span>{{ section.settings.journal_button_text }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<!-- =============================================
     POLICIES INFO BAR
     ============================================= -->
{%- if section.settings.show_policies -%}
<section class="sak-section sak-policies">
  <div class="sak-content-width">
    <div class="sak-policies__grid">
      <div class="sak-policies__item">
        <div class="sak-policies__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
